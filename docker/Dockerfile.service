FROM oven/bun:1 AS base
WORKDIR /app

# Install dependencies — all workspace manifests must be present for the
# lockfile to resolve.
COPY package.json bun.lock bunfig.toml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/service/package.json ./packages/service/
COPY packages/worker/package.json ./packages/worker/
COPY packages/frontend/package.json ./packages/frontend/
COPY packages/landing/package.json ./packages/landing/
RUN bun install --frozen-lockfile

# Copy source
COPY packages/shared ./packages/shared
COPY packages/service ./packages/service
COPY packages/frontend ./packages/frontend
COPY packages/landing ./packages/landing
COPY tsconfig.json ./

# Build both front ends; the service serves each dist same-origin — the SPA
# under /dashboard, the landing page at the root.
RUN bun run --cwd packages/frontend build
RUN bun run --cwd packages/landing build

EXPOSE 3000

CMD ["bun", "packages/service/src/index.ts"]
